# Server Port (automatically set by Railway in production)
PORT=5000

# Node Environment
NODE_ENV=production

# Allowed Frontend Origins (comma-separated for CORS)
ALLOWED_ORIGINS=https://stucowebsite-production.up.railway.app,http://localhost:5173,http://localhost:3000

# MongoDB Connection String (Railway / Atlas)
# In Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/kjsse_council?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kjsse_council?retryWrites=true&w=majority

# Supabase Auth Configuration
SUPABASE_URL=https://pvajqrvldshxgqkpsclm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-client-side

# Security Webhook Alerting (Optional: Discord/Slack webhook for real-time tampering alerts)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Fallback / Initial Google Form URL
INITIAL_GOOGLE_FORM_URL=https://forms.gle/y81No241PDAsHmBCA
